{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galeata",
  "version": "0.1.0",
  "identifier": "dev.olivierlb.galeata",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Galeata", "width": 1500, "height": 950, "minWidth": 1000, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:" }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"], "resources": { "target/release/galeata-mcp": "galeata-mcp" }, "shortDescription": "L’IDE pour travailler avec vos agents", "category": "DeveloperTool" }
}
