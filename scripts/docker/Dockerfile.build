# Linux build environment for Galeata: Ubuntu 22.04 (oldest supported glibc,
# same base as the release workflow), Node 24, Rust stable and Tauri 2 deps.
# Used by scripts/build-linux-docker.sh; no project files are baked in.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential pkg-config curl ca-certificates file git xz-utils \
       desktop-file-utils ripgrep \
       libwebkit2gtk-4.1-dev libgtk-3-dev libssl-dev libdbus-1-dev \
       libayatana-appindicator3-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION=24.11.0
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
    && node --version

ENV RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | CARGO_HOME=/usr/local/cargo sh -s -- -y --profile minimal --no-modify-path -c rustfmt -c clippy \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo \
    && rustc --version
