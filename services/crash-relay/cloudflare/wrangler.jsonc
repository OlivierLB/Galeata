{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galeata-crashes",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "GITHUB_REPOSITORY": "OlivierLB/Galeata" },
  "durable_objects": {
    "bindings": [{ "name": "CRASH_REPORTS", "class_name": "CrashReports" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CrashReports"] }],
  "ratelimits": [{ "name": "CLIENT_LIMITER", "namespace_id": "20901", "simple": { "limit": 5, "period": 60 } }]
}
