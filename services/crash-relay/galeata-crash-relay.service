[Unit]
Description=Relais de signalement des crashs Galeata
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/galeata-crash-relay
ExecStart=/usr/bin/node /opt/galeata-crash-relay/server.mjs
Environment=PORT=8787
Environment=GITHUB_REPOSITORY=OlivierLB/Galeata
Environment=GITHUB_TOKEN_FILE=%d/github-token
LoadCredentialEncrypted=github-token:/etc/credstore.encrypted/galeata-github-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
MemoryMax=128M

[Install]
WantedBy=multi-user.target
